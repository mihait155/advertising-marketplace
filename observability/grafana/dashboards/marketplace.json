      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"marketplace-backend\", uri!~\"/actuator.*|/livez|/readyz|/api/v1/conversations/events|/ws.*\"}[5m]))",
          "legendFormat": "{{status}}",
          "exemplar": false
