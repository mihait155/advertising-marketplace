      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"marketplace-backend\", uri!~\"/actuator.*|/livez|/readyz|/api/v1/conversations/events|/ws.*\"}[5m]))))",
          "legendFormat": "{{method}} {{uri}}",
