      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum by (method, uri, status) (rate(http_server_requests_seconds_count{job=\"marketplace-backend\", uri!~\"/actuator.*|/livez|/readyz|/api/v1/conversations/events|/ws.*\", status=~\"4..|5..\"}[5m])))",
