      "description": "Runs per hour: deal auto-approval, social sync, exchange rates, cleanups.",
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "com\\.advertisingmarketplace\\.(?:[a-z]+\\.)*([A-Za-z]+\\.[a-zA-Z]+ [A-Z_]+)",
